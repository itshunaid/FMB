@model BulkMenuScheduleViewModel
@{
    Layout = "~/Views/Management/_Layout.cshtml";
    ViewData["Title"] = "Schedule menus";
}
<div class="page-heading">
    <div><h1>Schedule menus</h1><p>Publish the same menu across a date range. Existing menus and finalized days are left unchanged.</p></div>
    <a class="btn-sm" href="/Management/Menus">Back to menus</a>
</div>
<div class="panel form-panel">
    <form method="post" action="/Management/Menus/BulkSchedule" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-message"></div>
        <label asp-for="StartDate">Start date<input asp-for="StartDate" type="date" /></label>
        <span asp-validation-for="StartDate" class="validation-message"></span>
        <label asp-for="EndDate">End date<input asp-for="EndDate" type="date" /></label>
        <span asp-validation-for="EndDate" class="validation-message"></span>
        <label asp-for="MenuName">Menu name<input asp-for="MenuName" maxlength="200" placeholder="Enter daily menu" /></label>
        <span asp-validation-for="MenuName" class="validation-message"></span>
        <div class="form-actions">
            <button class="btn" type="submit">Schedule menus</button>
            <a class="btn-sm" href="/Management/Menus">Cancel</a>
        </div>
    </form>
</div>
