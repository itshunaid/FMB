@model QueryReplyViewModel
@{
    Layout = "~/Views/Management/_Layout.cshtml";
    ViewData["Title"] = "Respond to query";
}
<div class="page-heading"><div><h1>Respond to query #@Model.Id</h1><p>Save a reply and update its tracking status.</p></div><a class="btn-sm" href="/Management/Queries">Back to queries</a></div>
<div class="panel form-panel">
    <form method="post" action="/Management/Queries/@Model.Id/Reply" class="form-grid">
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-message form-span"></div>
        <label asp-for="Reply" class="form-span">Reply<textarea asp-for="Reply" rows="6"></textarea></label><span asp-validation-for="Reply" class="validation-message"></span>
        <label asp-for="Status">Status<select asp-for="Status"><option>Open</option><option>In Progress</option><option>Resolved</option></select></label><span asp-validation-for="Status" class="validation-message"></span>
        <div class="form-actions form-span"><button class="btn" type="submit">Save response</button><a class="btn-sm" href="/Management/Queries">Cancel</a></div>
    </form>
</div>
