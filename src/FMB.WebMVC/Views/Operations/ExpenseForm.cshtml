@model ExpenseFormViewModel
@{
    Layout = "~/Views/Management/_Layout.cshtml";
    var isEdit = ViewContext.RouteData.Values["date"] is not null;
    ViewData["Title"] = isEdit ? "Edit expense" : "Add expense";
    var action = isEdit ? $"/Management/Expenses/{Model.Date:yyyy-MM-dd}/Edit" : "/Management/Expenses/Create";
}
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Enter the amounts from the daily kitchen bills.</p></div><a class="btn-sm" href="/Management/Expenses">Back to expenses</a></div>
<div class="panel form-panel">
    <form method="post" action="@action" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-message"></div>
        <label asp-for="Date">Service date<input asp-for="Date" type="date" /></label><span asp-validation-for="Date" class="validation-message"></span>
        <label asp-for="ThaliCount">Thali count<input asp-for="ThaliCount" type="number" min="1" /></label><span asp-validation-for="ThaliCount" class="validation-message"></span>
        <label asp-for="Groceries">Groceries (₹)<input asp-for="Groceries" type="number" step="0.01" min="0" /></label>
        <label asp-for="Meat">Meat (₹)<input asp-for="Meat" type="number" step="0.01" min="0" /></label>
        <label asp-for="Gas">Gas (₹)<input asp-for="Gas" type="number" step="0.01" min="0" /></label>
        <label asp-for="Labour">Labour (₹)<input asp-for="Labour" type="number" step="0.01" min="0" /></label>
        <label asp-for="Packaging">Packaging (₹)<input asp-for="Packaging" type="number" step="0.01" min="0" /></label>
        <label asp-for="Other">Other (₹)<input asp-for="Other" type="number" step="0.01" min="0" /></label>
        <label asp-for="Notes" class="form-span">Notes<textarea asp-for="Notes" rows="3" maxlength="1000"></textarea></label>
        <div class="form-actions form-span"><button class="btn" type="submit">Save expense</button><a class="btn-sm" href="/Management/Expenses">Cancel</a></div>
    </form>
</div>
