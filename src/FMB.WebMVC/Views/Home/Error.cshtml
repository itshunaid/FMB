@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Something went wrong";
}

<main class="error-page">
    <h1>Something went wrong</h1>
    <p>The request could not be completed. Please try again or contact an administrator.</p>
    <p class="muted">Reference: <code>@Context.TraceIdentifier</code></p>
    <a class="btn" href="/Home/Login">Return to sign in</a>
</main>
