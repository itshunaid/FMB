@model FMB.WebMVC.Controllers.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sign in";
    var demoHouseholdItsId = Model.DemoHouseholdItsId ?? "30400007";
    var demoHouseholdThaliNumber = Model.DemoHouseholdThaliNumber;
}

<div class="auth-shell">
    <div class="auth-left">
        <div class="brand-card">
            <div class="logo-mark">✦</div>
        </div>

        <h1 class="auth-heading">Tiffin Tracker</h1>

        <p class="auth-copy">Faiz ul Mawaid il Burhaniyah — Hussaini Alam</p>

        <ul class="auth-list">
            <li>Today's menu and collection time</li>
            <li>Thali status and reminders</li>
            <li>Share feedback in one tap</li>
            <li>Staff tools: gate, expenses, reports</li>
        </ul>
    </div>

    <div class="auth-right">
        <div class="login-card">
            <h2 class="login-title">Sign in</h2>
            <p class="login-subtitle">Sign in to your tiffin account</p>

            <form asp-action="Authenticate" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="LoginAs" type="hidden" id="loginAs" />
                @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
                {
                    <div class="login-error">@Model.ErrorMessage</div>
                }

                <div class="form-group">
                    <label asp-for="ItsId" id="loginIdLabel">HOF ITS ID or Thali number</label>
                    <input asp-for="ItsId"
                           class="login-input"
                           placeholder="e.g. @demoHouseholdThaliNumber or @demoHouseholdItsId"
                           data-household-placeholder="e.g. @demoHouseholdThaliNumber or @demoHouseholdItsId"
                           data-staff-placeholder="e.g. 30455616"
                           autocomplete="username" />
                </div>

                <div class="form-group">
                    <label asp-for="Pin" id="loginPasswordLabel">Password</label>
                    <input asp-for="Pin" type="password" class="login-input" placeholder="Password" autocomplete="current-password" />
                </div>

                <div class="form-group">
                    <label>Login as</label>
                    <div class="login-role-toggle" role="group" aria-label="Choose account type">
                        <button type="button" class="login-role-button" data-login-role="Household">Household</button>
                        <button type="button" class="login-role-button" data-login-role="Staff">User</button>
                    </div>
                </div>
                <button type="submit" class="auth-submit">Sign in</button>
            </form>

            @if (Model.DemoLoginEnabled)
            {
                <div class="login-meta">
                    <div data-login-demo="Household">
                        Demo household: Thali number <strong>@Model.DemoHouseholdThaliNumber</strong> or ITS ID
                        <strong>@(Model.DemoHouseholdItsId ?? "not seeded")</strong> — password <strong>1234</strong>.
                    </div>
                    <div data-login-demo="Staff" hidden>
                        Demo users:<br />
                        @foreach (var user in Model.DemoStaffUsers)
                        {
                            <span class="login-demo-user"><strong>@user.ItsId</strong> @user.Name (@user.Role)</span>
                        }
                        — password <strong>1234</strong>.
                    </div>
                </div>
            }
        </div>
    </div>
</div>
