@model IEnumerable<FMB.Domain.Entities.AuditLog>

<h2>System Audit Logs</h2>
<div class="c">
    <table>
        <thead>
            <tr><th>Timestamp</th><th>Performed By</th><th>Action</th><th>Target</th></tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@log.PerformedBy</td>
                    <td>@log.Action</td>
                    <td>@log.TargetItem</td>
                </tr>
            }
        </tbody>
    </table>
</div>
