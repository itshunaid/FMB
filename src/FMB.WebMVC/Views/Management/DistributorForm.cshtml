@model FMB.WebMVC.Controllers.DistributorFormViewModel
@{
    Layout = "~/Views/Management/_Layout.cshtml";
    var editing = ViewContext.RouteData.Values["action"]?.ToString() == "EditDistributor";
    ViewData["Title"] = editing ? "Edit Distributor" : "Add Distributor";
}

<div class="page-heading">
    <div><h1>@ViewData["Title"]</h1><p>Distributor contact and status.</p></div>
    <a class="btn btn-secondary" href="/Management/Distributors">Back to distributors</a>
</div>
<form asp-action="@(editing ? "EditDistributor" : "CreateDistributor")" asp-route-id="@Model.Id" method="post" class="panel form-panel">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-message"></div>
    <div class="form-grid">
        <div class="form-group">
            <label asp-for="Id">Distributor ID</label>
            <input asp-for="Id" class="form-input" readonly="@(editing ? "readonly" : null)" />
            <span asp-validation-for="Id" class="validation-message"></span>
        </div>
        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" class="form-input" />
            <span asp-validation-for="Name" class="validation-message"></span>
        </div>
        <div class="form-group">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="form-input" />
            <span asp-validation-for="Phone" class="validation-message"></span>
        </div>
        <div class="form-group">
            <label asp-for="Status">Status</label>
            <select asp-for="Status" class="form-input"><option>Active</option><option>Inactive</option></select>
            <span asp-validation-for="Status" class="validation-message"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn">Save distributor</button>
        <a class="btn btn-secondary" href="/Management/Distributors">Cancel</a>
    </div>
</form>
